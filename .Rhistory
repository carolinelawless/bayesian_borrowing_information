alpha_TEA_EB_epsilon<- c( 0.24, 0.26, 0.42, 0.36, 0.44, 0.48, 0.42, 0.5, 0.58, 0.58, 0.62, 0.52, 0.5, 0.58, 0.62, 0.54, 0.66, 0.58, 0.6, 0.52, 0.72, 0.7, 0.58, 0.64, 0.58 )
