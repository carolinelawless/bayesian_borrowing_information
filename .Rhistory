alpha_TEA_EB_0.5<- c( 0.32, 0.36, 0.46, 0.44, 0.56, 0.6, 0.66, 0.66, 0.56, 0.6, 0.74, 0.64, 0.7, 0.72, 0.72, 0.76, 0.8, 0.76, 0.76, 0.82, 0.7, 0.8, 0.84, 0.88, 0.88 )
