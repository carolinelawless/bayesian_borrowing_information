variance_EB <- var(diffs)
proba_new_trial_EB <- sum(diffs > thres)/B
CSD <- 1
res<- posterior_sim_binomial(params, M, B, lambdas, a_theta, b_theta, epsilon_const, CSD)
diffs <- res$diffs
bias_TEA <- mean(diffs) - true_diff
variance_TEA <- var(diffs)
proba_new_trial_TEA <- sum(diffs > thres)/B
proba_EB <- c(proba_EB, proba_new_trial_EB)
proba_TEA <- c(proba_TEA, proba_new_trial_TEA)
}
plot(lambda_vector, proba_EB, type = "l",
